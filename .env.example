# ==============================================================================
# Zuperior MetaTrader 5 (MT5) Algorithmic Signal Engine - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Zuperior MT5 Broker Connection Settings
# ------------------------------------------------------------------------------
# Your numeric MT5 account login ID
MT5_LOGIN=1089542

# Your MT5 master account password
MT5_PASSWORD=YourSecureZuperiorPasswordHere

# Zuperior broker server name (e.g. Zuperior-Live, Zuperior-Demo, Zuperior-Server)
MT5_SERVER=Zuperior-Demo

# Optional: Path to 64-bit terminal executable (terminal64.exe).
# Leave blank to let MetaTrader5 auto-detect the default installed terminal.
# Windows Example: C:\Program Files\Zuperior MT5 Terminal\terminal64.exe
# Wine Example:    /home/user/.wine/drive_c/Program Files/Zuperior MT5/terminal64.exe
MT5_PATH=

# Connection timeout in milliseconds
MT5_TIMEOUT_MS=60000

# Set to true to fetch REAL LIVE market data from Binance (Bitcoin, Gold, Nasdaq) directly on Linux
USE_BINANCE=true

# Set to true to force simulation / mock bridge mode (useful for offline testing or dry runs)
USE_MOCK_MT5=false

# ------------------------------------------------------------------------------
# 2. Risk Management & Position Sizing
# ------------------------------------------------------------------------------
# Risk percentage per trade calculated against live account equity (default 1.0%)
RISK_PERCENT=1.0

# Hard dollar ceiling per trade regardless of equity
MAX_RISK_USD=1000.0

# Minimum Risk-to-Reward ratio gatekeeper (signals < 1:2.5 are rejected)
MIN_RR_RATIO=2.5

# Take Profit 1 Risk-to-Reward multiple (partial 50% scale-out target)
TP1_RR_RATIO=2.5

# Take Profit 2 Risk-to-Reward multiple (runner target)
TP2_RR_RATIO=3.5

# Dynamic ATR Stop Loss multiplier
ATR_STOP_MULTIPLIER=1.5

# Maximum daily loss percent before circuit breaker activates
MAX_DAILY_LOSS_PERCENT=3.0

# Maximum simultaneous open signals/positions
MAX_OPEN_POSITIONS=3

# ------------------------------------------------------------------------------
# 3. Zuperior Live Spread & Session Liquidity Gatekeepers
# ------------------------------------------------------------------------------
# Rejection multiplier: rejects signals if live spread > (multiplier * rolling_median_spread)
# Protects against offshore broker spread spikes, illiquid rollover (21:00-23:00 UTC), and news events
SPREAD_MEDIAN_MULTIPLIER=1.8
ROLLING_SPREAD_BARS=50

# Hard absolute spread caps in price units (e.g. 0.60 = $0.60 on Gold)
MAX_SPREAD_GOLD=0.60
MAX_SPREAD_BTC=50.0
MAX_SPREAD_NASDAQ=3.5

# Peak Liquidity Windows in UTC (HH:MM format)
# Gold: London/NY morning liquidity overlap
GOLD_SESSION_START_UTC=12:00
GOLD_SESSION_END_UTC=16:30

# Nasdaq: US Cash Open through peak institutional volume
NASDAQ_SESSION_START_UTC=14:30
NASDAQ_SESSION_END_UTC=17:00

# Bitcoin: Filter out low-volatility weekend chop (Saturday/Sunday)
BTC_FILTER_WEEKEND_CHOP=true
BTC_WEEKEND_MIN_ADX=22.0

# ------------------------------------------------------------------------------
# 4. Multi-Timeframe Technical Regime Thresholds
# ------------------------------------------------------------------------------
# ADX thresholds
ADX_BREAKOUT_THRESHOLD=25.0
ADX_REVERSAL_THRESHOLD=22.0

# Bitcoin institutional tick-volume spike multiplier (relative to 20-period volume SMA)
BTC_VOLUME_SPIKE_MULTIPLIER=1.8

# Minimum number of aligned technical confluence factors required to emit alert
MIN_CONFLUENCES=3

# ------------------------------------------------------------------------------
# 5. Telegram & Webhook Notifications
# ------------------------------------------------------------------------------
ENABLE_CONSOLE=true
ENABLE_TELEGRAM=true
ENABLE_WEBHOOK=true

# Telegram Bot API Token from @BotFather
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ_1234567

# Telegram Chat ID (channel, group, or user ID)
TELEGRAM_CHAT_ID=-1001234567890

# Discord, Slack, n8n, or Zapier Webhook URL
WEBHOOK_URL=https://discord.com/api/webhooks/your/webhook/url

# Signal deduplication cooldown in minutes (prevents duplicate spam on same candle)
DEDUP_COOLDOWN_MINUTES=15

# Main loop scan interval in seconds
SCAN_INTERVAL_SECONDS=30
